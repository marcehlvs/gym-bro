rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Es entrenador quien tiene un documento admins/{su uid}, creado a mano en la consola.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid; // solo para saber si sos admin
    }

    match /socios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','days','updated']);
    }
  }
}
